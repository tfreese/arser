<?xml version="1.0" encoding="UTF-8"?>

<!-- https://www.w3schools.com/xml/schema_intro.asp -->

<!--<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://github.com/tfreese/arser/config"
           targetNamespace="http://github.com/tfreese/arser/config"
           attributeFormDefault="unqualified"
           elementFormDefault="qualified"
>

    <!--    <import schemaLocation="baseTypes.xsd" namespace="http://baseTypes" />-->

    <!-- Types -->
    <xs:simpleType name="FileUriType">
        <xs:annotation>
            <xs:documentation source="description">file://*</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:anyURI">
            <xs:minLength value="10" />
            <xs:pattern value="file://.*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="HttpUriType">
        <xs:annotation>
            <xs:documentation source="description">https://*, http://*</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:anyURI">
            <xs:minLength value="10" />
            <xs:pattern value="https://.*" />
            <xs:pattern value="http://.*" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="RepositoryNameType">
        <xs:annotation>
            <xs:documentation source="description">Name of a Repository</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:normalizedString">
            <xs:minLength value="5" />
            <xs:pattern value="([a-z0-9\-_])+" />
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="ThreadPoolConfig">
        <xs:annotation>
            <xs:documentation source="description">Configuration for a ThreadPool.</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="namePattern" type="xs:normalizedString" />
            <xs:element name="coreSize" type="xs:int" />
            <xs:element name="maxSize" type="xs:int" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ServerConfig">
        <xs:sequence>
            <!-- <xs:element name="alter" type="xs:int" minOccurs="0" /> -->
            <xs:element name="port">
                <xs:annotation>
                    <xs:documentation source="description">Port for the Server [1025-65534].</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:positiveInteger">
                        <xs:minInclusive value="1025" />
                        <xs:maxInclusive value="65534" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
            <xs:element name="threadPoolConfig" type="ThreadPoolConfig" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="FileRepositoryConfig">
        <xs:annotation>
            <xs:documentation source="description">File Repository [file://*].</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="name" type="RepositoryNameType" />
            <xs:element name="uri" type="FileUriType" />
            <xs:element name="logging" type="xs:boolean" />
            <xs:element name="readOnly" type="xs:boolean" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="HttpRepositoryConfig">
        <xs:annotation>
            <xs:documentation source="description">Remote Repository [https://*,http://*].</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="name" type="RepositoryNameType" />
            <xs:element name="uri" type="HttpUriType" />
            <xs:element name="logging" type="xs:boolean" />
            <xs:element name="cachingPath" type="xs:normalizedString" />
            <xs:element name="connectTimeout" type="xs:duration" />
            <xs:element name="maxRetries" type="xs:int" />
            <xs:element name="retryInterval" type="xs:duration" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="VirtualRepositoryConfig">
        <xs:annotation>
            <xs:documentation source="description">
                Virtual Repository as mirror [https://HOST:PORT/NAME]
                Processed in declarative order.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="name" type="RepositoryNameType" />
            <xs:element name="uri" type="xs:normalizedString" maxOccurs="unbounded" />
            <xs:element name="logging" type="xs:boolean" />
            <xs:element name="repository-ref" type="xs:normalizedString" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:complexType>

    <!-- Elements / Types -->
    <xs:element name="ArserConfig">
        <xs:annotation>
            <xs:documentation source="description">Configuration for the ARtifact-SERvice.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ServerConfig" type="ServerConfig" />
                <xs:element name="FileRepositoryConfigs" type="FileRepositoryConfigs" />
                <xs:element name="HttpRepositoryConfigs" type="HttpRepositoryConfigs" />
                <xs:element name="VirtualRepositoryConfigs" type="VirtualRepositoryConfigs" />
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="FileRepositoryConfigs">
        <xs:sequence>
            <xs:element name="FileRepositoryConfig" type="FileRepositoryConfig" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="HttpRepositoryConfigs">
        <xs:sequence>
            <xs:element name="HttpRepositoryConfig" type="HttpRepositoryConfig" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="VirtualRepositoryConfigs">
        <xs:sequence>
            <xs:element name="VirtualRepositoryConfig" type="VirtualRepositoryConfig" minOccurs="0" />
        </xs:sequence>
    </xs:complexType>

