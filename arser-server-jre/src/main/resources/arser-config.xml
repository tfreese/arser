<?xml version="1.0" encoding="UTF-8"?>

<arserConfig
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://github.com/tfreese/arser/config"
        xsi:schemaLocation="http://github.com/tfreese/arser/config https://raw.githubusercontent.com/tfreese/arser/refs/heads/master/arser-core/src/main/resources/config/arser-config.xsd">

    <serverConfig>
        <port>8484</port>

        <threadPoolConfig>
            <namePattern>thread-%d</namePattern>
            <coreSize>1</coreSize>
            <maxSize>5</maxSize>
        </threadPoolConfig>
    </serverConfig>

    <fileRepositoryConfigs>
        <fileRepositoryConfig>
            <name>snapshots</name>
            <uri>file:///tmp/arser/local/snapshots</uri>
            <logging>true</logging>
            <readOnly>false</readOnly>
        </fileRepositoryConfig>
    </fileRepositoryConfigs>

    <httpRepositoryConfigs>
        <httpRepositoryConfig>
            <name>maven-central</name>
            <uri>https://repo1.maven.org/maven2</uri>
            <logging>true</logging>
            <cachingPath>file:///tmp/arser/cache/maven-central</cachingPath>
            <connectTimeout>PT10S</connectTimeout>
            <maxRetries>3</maxRetries>
            <retryInterval>PT2S</retryInterval>
        </httpRepositoryConfig>
        <httpRepositoryConfig>
            <name>gradle-libs-releases</name>
            <uri>https://repo.gradle.org/gradle/libs-releases</uri>
            <logging>true</logging>
            <cachingPath>file:///tmp/arser/cache/gradle-libs-releases</cachingPath>
            <connectTimeout>PT10S</connectTimeout>
            <maxRetries>3</maxRetries>
            <retryInterval>PT2S</retryInterval>
        </httpRepositoryConfig>
    </httpRepositoryConfigs>

    <virtualRepositoryConfigs>
        <virtualRepositoryConfig>
            <name>public</name>
            <uri>virtual</uri>
            <logging>true</logging>
            <repositoryRefs>
                <repositoryRef>maven-central</repositoryRef>
                <repositoryRef>gradle-libs-releases</repositoryRef>
                <repositoryRef>snapshots</repositoryRef>
            </repositoryRefs>
        </virtualRepositoryConfig>
    </virtualRepositoryConfigs>
</arserConfig>
